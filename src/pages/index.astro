---
import Base from '../layouts/Base.astro';
import { proximosTalleres, formatearFechaTaller } from '../lib/agenda';
import { site } from '../site';

const proximos = (await proximosTalleres()).slice(0, 4);

const bloques = [
  {
    href: '/tienda/',
    titulo: 'Tienda',
    texto:
      'Piezas de joyería hechas en nuestro taller, productos para el cuidado personal elaborados por otros artesanos y el trabajo de productores de la región. Cantidades pequeñas, materiales nobles y procesos que podemos explicar uno por uno.',
    enlace: 'Ver la tienda',
  },
  {
    href: '/joyeria/',
    titulo: 'Estudio de joyería',
    texto:
      'Talleres de un día, cursos trimestrales y clases individuales, en el mismo taller donde se produce. De una clase se sale con una pieza terminada y hecha por uno mismo.',
    enlace: 'Conocer el estudio',
  },
  {
    href: '/yoga/',
    titulo: 'Estudio de yoga y meditación',
    texto:
      'Clases regulares de yoga con Alexandra, formada y certificada en kundalini yoga. El grupo de meditación se reúne los martes por la mañana, es gratuito y abierto, sin marco religioso.',
    enlace: 'Horarios y prácticas',
  },
  {
    href: '/talleres/',
    titulo: 'Talleres',
    texto:
      'Encuadernación, tejido, bordado, cocina y otros oficios y prácticas, casi siempre en fin de semana, dictados por talleristas invitados. Se sale con algo hecho a mano.',
    enlace: 'Ver los talleres',
  },
];
---

<Base>
  <section class="hero">
    <div class="hero-media">
      <img src="/fotos/joyeria/portada-manos-cobre.jpg" alt="" />
    </div>
    <div class="hero-overlay"></div>
    <div class="container">
      <p class="eyebrow">{site.lugar}</p>
      <h1 class="hero-logo">
        <img src="/logo-suma.png" alt={site.nombre} />
      </h1>
      <p class="tagline">
        Joyeros, artistas y artesanos en un mismo lugar. Vendemos lo que hacemos, enseñamos el
        oficio y practicamos yoga. Promovemos economías locales.
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn btn--light" href="/agenda/">Ver la agenda</a>
        <a class="btn" href="/visitar/" style="margin-left: 0.75rem;">Cómo llegar</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {bloques.map((b) => (
          <a class="card card-link" href={b.href} style="text-decoration:none; color:inherit;">
            <div class="card-body">
              <h3>{b.titulo}</h3>
              <p>{b.texto}</p>
              <p class="card-meta">{b.enlace} →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {proximos.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Qué viene</p>
          <h2>Próximas fechas</h2>
        </div>
        <div>
          {proximos.map((taller) => (
            <a class="list-item" href={`/talleres/${taller.id}/`} style="text-decoration:none; color:inherit;">
              <div class="list-item-body">
                <div class="list-item-meta">
                  {formatearFechaTaller(taller.data.fecha, taller.data.fechaFin)}
                </div>
                <h3>{taller.data.title}</h3>
                <p>{taller.data.precio ?? 'Valor por definir'}</p>
              </div>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem;"><a class="btn" href="/agenda/">Ver toda la agenda</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>También en SUMA</h2>
      </div>
      <div class="prose" style="max-width:70ch; color:var(--ink-soft);">
        <p>
          <strong>Fanzine.</strong> Publicación autogestionada de SUMA, de entrega gratuita.
        </p>
        <p><strong>Cine club.</strong> Encuentros para aprender a ver cine, los jueves de 6:00 a 7:00 p. m.</p>
        <p><strong>Exposiciones.</strong> Muestras en el espacio y obra de artistas en las paredes.</p>
        <p>
          <strong>Club de lectura.</strong> Creado por SUMA, hoy en colaboración con la librería
          Tinta y Tiempo.
        </p>
      </div>
    </div>
  </section>
</Base>
