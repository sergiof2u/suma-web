---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { proximosTalleres, talleresPasados, formatearFechaTaller } from '../../lib/agenda';
import { site } from '../../site';

const proximos = await proximosTalleres();
const pasados = (await talleresPasados()).slice(0, 8);
const talleristas = await getCollection('talleristas');
const nombre = (id?: string) => talleristas.find((t) => t.id === id)?.data.nombre;
---

<Base
  title="Talleres"
  description="Talleres de oficios en SUMA, Subachoque: encuadernación, bordado, tejido, cocina y otras prácticas, con talleristas invitados."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Oficios</p>
        <h1>Talleres</h1>
      </div>

      <div class="prose" style="max-width:70ch; color:var(--ink-soft); margin-bottom:2.5rem;">
        <p>
          En el salón de SUMA se dictan talleres de oficios, artesanías y prácticas del cuerpo
          y la atención. Encuadernación, bordado, tejido, cocina, chi kung, percusión. Casi
          siempre en fin de semana, casi siempre de una jornada.
        </p>
        <p>
          Los dictan talleristas invitados, cada uno con su nombre y su manera de trabajar.
          De un taller se sale con algo hecho a mano.
        </p>
      </div>

      <h2>Lo que viene</h2>
      <div>
        {proximos.map((taller) => (
          <a class="list-item" href={`/talleres/${taller.id}/`} style="text-decoration:none; color:inherit;">
            {taller.data.imagen && (
              <div class="list-item-media">
                <img src={taller.data.imagen} alt={taller.data.title} loading="lazy" />
              </div>
            )}
            <div class="list-item-body">
              <div class="list-item-meta">
                {formatearFechaTaller(taller.data.fecha, taller.data.fechaFin)}
                {nombre(taller.data.tallerista) ? ` · con ${nombre(taller.data.tallerista)}` : ''}
              </div>
              <h3>{taller.data.title}</h3>
              {taller.data.horario && <p>{taller.data.horario}</p>}
              <p>{taller.data.precio ?? 'Valor por definir'}</p>
            </div>
          </a>
        ))}
        {proximos.length === 0 && (
          <p style="color:var(--ink-soft);">
            No hay talleres programados en este momento. Las fechas nuevas se publican acá y en
            <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener"> Instagram</a>.
          </p>
        )}
      </div>

      {pasados.length > 0 && (
        <div style="margin-top:3.5rem;">
          <h2>Lo que se ha dictado acá</h2>
          <ul style="line-height:2; color:var(--ink-soft);">
            {pasados.map((taller) => (
              <li>
                {taller.data.title}
                {nombre(taller.data.tallerista) ? `, con ${nombre(taller.data.tallerista)}` : ''}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div style="background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius); padding:1.5rem 1.75rem; margin-top:3.5rem;">
        <h3 style="margin-bottom:0.5rem;">¿Dictas un oficio?</h3>
        <p style="margin:0 0 1.25rem; color:var(--ink-soft);">
          El salón se abre a talleristas de afuera. Buscamos gente que enseñe oficios,
          artesanías y prácticas del cuerpo y la atención.
        </p>
        <a class="btn" href="/dicta-un-taller/">Dicta un taller en SUMA</a>
      </div>
    </div>
  </section>
</Base>
